{
  "name": "max-planner",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Static web app that plans how many days a Clash of Clans village needs to max, from a pasted in-game export.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test --test-reporter=spec \"packages/*/src/**/*.test.ts\" \"tools/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "gamedata:build": "node tools/gamedata-build/src/build.ts",
    "web:build": "node tools/web-build/src/build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "3.8.1",
    "typescript": "7.0.2"
  }
}
